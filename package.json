{
  "name": "efacture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC — Générateur de factures électroniques conformes (Factur-X / EN 16931)",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx src/cli/generate.ts",
    "vendor:ubl": "node scripts/fetch-en16931-ubl.js"
  },
  "dependencies": {
    "@stafyniaksacha/facturx": "0.6.1",
    "express": "^5.1.0",
    "libxml2-wasm": "^0.7.2",
    "node-zugferd": "0.1.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.1",
    "saxon-js": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "xslt3": "^2.7.0"
  }
}
